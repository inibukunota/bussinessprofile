---
import { site } from '../config/site';
interface Props { id?: string; hidden?: boolean; labelledby?: string }
const { id = 'panel-book', hidden = false, labelledby = 'tab-book' } = Astro.props;
---

<div class="tab-panel" class:list={[{ 'is-active': !hidden }]} id={id} role="tabpanel" aria-labelledby={labelledby} hidden={hidden}>
  <p class="booking-intro">Pick a time that works for you. You'll get a confirmation and a calendar invite right away.</p>
  <div class="booking-embed">
    <iframe src={`${site.bookingUrl}?gv=true`} title="Book a consultation" loading="lazy"></iframe>
    <div class="booking-fallback">
      <span>Embed not loading?</span>
      <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener">
        Open scheduling page
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" /></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; }
  .booking-intro { margin: 0 0 1.5rem; color: var(--ink-soft); }
  .booking-embed { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--white); }
  .booking-embed iframe { width: 100%; height: 640px; border: 0; display: block; }
  .booking-fallback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--parchment-2);
    border: 1px solid var(--line);
    border-top: none;
    border-radius: 0 0 var(--radius) var(--radius);
    padding: 1rem 1.25rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .btn:hover { background: var(--brass-dark); border-color: var(--brass-dark); }

  @media (max-width: 620px) {
    .booking-embed iframe { height: 560px; }
  }
</style>

---
interface Props {
  href: string;
  title: string;
  description: string;
  icon: 'translation' | 'protection' | 'pusaka';
}
const { href, title, description, icon } = Astro.props;

// Icon paths keyed by service — no numbered badges, since the three
// services aren't a sequence; each gets its own mark instead.
const icons: Record<string, string> = {
  translation: 'M4 19h16M6 15l4-9 4 9M7.5 12h5',
  protection: 'M12 3l7 3v6c0 4.4-3 8-7 9-4-1-7-4.6-7-9V6z',
  pusaka: 'M4 21V9l8-5 8 5v12M4 21h16M9 21v-6h6v6',
};
---

<a class="card" href={href}>
  <span class="seal" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d={icons[icon]} />
    </svg>
  </span>
  <h2>{title}</h2>
  <p>{description}</p>
  <span class="goto">
    Explore this service
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--parchment-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 2.2vw, 2rem) clamp(1.25rem, 2vw, 1.6rem);
    text-decoration: none;
    color: var(--ink);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--brass);
    box-shadow: 0 10px 24px -16px rgba(30, 42, 56, 0.35);
  }
  .seal {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--brass);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--white);
  }
  .seal svg { width: 24px; height: 24px; stroke: var(--brass-dark); }
  .card h2 { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; margin: 0; line-height: 1.25; }
  .card p { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--ink-soft); flex: 1; }
  .card .goto { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--sage); display: flex; align-items: center; gap: 0.4rem; }
  .card .goto svg { width: 14px; height: 14px; transition: transform var(--transition); }
  .card:hover .goto svg { transform: translateX(3px); }
</style>

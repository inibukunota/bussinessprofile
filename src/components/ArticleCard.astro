---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
}
const { href, title, description, date } = Astro.props;
const formattedDate = date.toLocaleDateString('en-MY', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a class="article-card" href={href}>
  <span class="date">{formattedDate}</span>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--transition), transform var(--transition);
  }
  .article-card:hover { border-color: var(--brass); transform: translateY(-2px); }
  .date { font-family: var(--font-mono); font-size: 0.72rem; color: var(--sage); }
  .article-card h3 { font-family: var(--font-display); font-size: 1rem; margin: 0; line-height: 1.35; font-weight: 600; }
  .article-card p { margin: 0; font-size: 0.85rem; color: var(--ink-soft); }
</style>

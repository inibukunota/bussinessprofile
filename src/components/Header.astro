---
import { site } from '../config/site';
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/services/translation-editing-writing', label: 'Translation' },
  { href: '/services/financial-protection', label: 'Protection' },
  { href: '/services/pusaka-management', label: 'Pusaka' },
  { href: '/articles', label: 'Articles' },
  { href: '/about', label: 'About Us' },
];
---

<header class="site-header">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">{site.name.split(' ').map((word) => word[0]).slice(0, 2).join('')}</span><span>{site.name}</span></a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} aria-current={currentPath === item.href || (item.href === '/articles' && currentPath.startsWith('/articles/')) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="nav-cta" href="/consultation">Book a consultation</a>
  </div>
</header>
<style>
.site-header { position:relative; display:flex; align-items:center; justify-content:space-between; gap:1.5rem; padding:1.25rem clamp(1.25rem,4vw,3rem); border-bottom:1px solid var(--line); }
.brand { display:flex; align-items:center; gap:.6rem; font-family:var(--font-display); font-size:1.15rem; font-weight:600; text-decoration:none; color:var(--ink); }
.brand-mark { width:30px; height:30px; flex:0 0 auto; display:grid; place-items:center; border:1.5px solid var(--brass); border-radius:50%; color:var(--brass-dark); font-family:var(--font-mono); font-size:.7rem; }
.header-actions { display:flex; align-items:center; gap:clamp(.75rem,2vw,1.5rem); flex:0 0 auto; }
.site-nav { display:flex; align-items:center; gap:clamp(.75rem,2vw,1.5rem); font-size:.95rem; white-space:nowrap; }
.site-nav a { padding-block:.25rem; border-bottom:2px solid transparent; color:var(--ink-soft); text-decoration:none; transition:color var(--transition),border-color var(--transition); }
.site-nav a:hover { color:var(--ink); }
.site-nav a[aria-current='page'] { border-color:var(--brass); color:var(--ink); }
.nav-cta { padding:.5rem 1rem; border:1px solid var(--ink); border-radius:var(--radius); color:var(--ink); white-space:nowrap; }
.nav-cta:hover { background:var(--ink); color:var(--white); }
@media (max-width:900px) {
  .site-header { flex-direction:column; align-items:stretch; gap:.75rem; }
  .header-actions { flex-direction:column; align-items:stretch; gap:.5rem; min-width:0; }
  .site-nav { width:100%; min-width:0; gap:1.25rem; overflow-x:auto; overscroll-behavior-inline:contain; scroll-snap-type:x proximity; scrollbar-color:var(--line) transparent; scrollbar-width:thin; padding-block:.2rem .5rem; }
  .site-nav a { flex:0 0 auto; scroll-snap-align:start; }
  .nav-cta { align-self:flex-end; }
}
@media (prefers-reduced-motion: reduce) { .site-nav a { transition:none; } }
</style>

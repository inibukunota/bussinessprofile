---
interface Point { title: string; description: string }
interface Props { heading: string; points: Point[] }
const { heading, points } = Astro.props;
---

<section class="why-us" aria-labelledby="why-h">
  <div class="section-head">
    <p class="kicker">Why choose us</p>
    <h2 id="why-h">{heading}</h2>
  </div>
  <div class="why-grid">
    {points.map((point) => (
      <div>
        <h3>{point.title}</h3>
        <p>{point.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .why-us { padding: clamp(2.5rem, 6vw, 4rem) 0; border-top: 1px solid var(--line); }
  .kicker { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage); margin: 0 0 0.5rem; }
  h2 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 2.6vw, 1.9rem); margin: 0; line-height: 1.2; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .why-grid h3 { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 0.5rem; font-weight: 600; }
  .why-grid p { margin: 0; font-size: 0.9rem; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../config/site';
---

<BaseLayout title="Articles" description="Guides and articles on translation, financial protection, and pusaka management planning.">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Home</a> / Articles</p>

    <header class="page-header">
      <p class="kicker">Articles</p>
      <h1>Reading by topic</h1>
      <p class="intro">Choose a category to browse related guides and articles.</p>
    </header>

    <div class="service-grid">
      <ServiceCard
        href={`/articles/${services.translation.articleCategory}`}
        title={services.translation.label}
        icon="translation"
        description="Guides on preparing, requesting and understanding translation, editing and writing work."
      />
      <ServiceCard
        href={`/articles/${services.protection.articleCategory}`}
        title={services.protection.label}
        icon="protection"
        description="Guides on understanding and choosing financial protection coverage."
      />
      <ServiceCard
        href={`/articles/${services.pusaka.articleCategory}`}
        title={services.pusaka.label}
        icon="pusaka"
        description="Guides on organising pusaka and estate matters for your family."
      />
    </div>
  </div>
</BaseLayout>

<style>
  .page-header { padding: 1.75rem 0 2rem; max-width: 40rem; }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 0.6rem;
  }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin: 0 0 0.7rem; }
  .intro { color: var(--ink-soft); margin: 0; }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-bottom: 3.5rem;
  }

  @media (max-width: 900px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>

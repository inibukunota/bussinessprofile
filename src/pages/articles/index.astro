---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../config/site';
---

<BaseLayout title="Articles" description="Guides and articles on translation, financial protection, and pusaka management planning.">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Home</a> / Articles</p>

    <header class="page-header">
      <p class="kicker">Articles</p>
      <h1>Reading by topic</h1>
      <p class="intro">Choose a category to browse related guides and articles.</p>
    </header>

    <div class="service-grid">
      {Object.values(services).map((service) => (
        <a class="topic-card" href={`/articles/${service.articleCategory}`}>
          <span class="topic-mark" aria-hidden="true">{service.shortLabel.slice(0, 2).toUpperCase()}</span>
          <h2>{service.label}</h2>
          <p>{service.articleCategory === 'translation' ? 'Guides on preparing, requesting and understanding translation, editing and writing work.' : service.articleCategory === 'financial-protection' ? 'Guides on understanding and choosing financial protection coverage.' : 'Guides on organising pusaka and estate matters for your family.'}</p>
          <span class="topic-link">Browse articles →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header { padding: 1.75rem 0 2rem; max-width: 40rem; }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 0.6rem;
  }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin: 0 0 0.7rem; }
  .intro { color: var(--ink-soft); margin: 0; }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-bottom: 3.5rem;
  }

  .topic-card { display:flex; flex-direction:column; gap:1rem; background:var(--parchment-2); border:1px solid var(--line); border-radius:var(--radius); padding:clamp(1.5rem,2.2vw,2rem) clamp(1.25rem,2vw,1.6rem); text-decoration:none; color:var(--ink); transition:transform var(--transition),border-color var(--transition),box-shadow var(--transition); }
  .topic-card:hover,.topic-card:focus-visible { transform:translateY(-3px); border-color:var(--brass); box-shadow:0 10px 24px -16px rgba(30,42,56,.35); }
  .topic-mark { width:52px; height:52px; display:grid; place-items:center; border:1.5px solid var(--brass); border-radius:50%; background:var(--white); color:var(--brass-dark); font-family:var(--font-mono); font-size:.7rem; }
  .topic-card h2 { margin:0; font-family:var(--font-display); font-size:1.25rem; line-height:1.25; font-weight:600; }
  .topic-card p { margin:0; color:var(--ink-soft); font-size:.92rem; line-height:1.55; flex:1; }
  .topic-link { color:var(--sage); font-family:var(--font-mono); font-size:.78rem; }

  @media (max-width: 900px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found.">
  <div class="not-found wrap-narrow">
    <p class="kicker">404</p>
    <h1>That page isn't here.</h1>
    <p>The address may have changed, or the page may no longer exist.</p>
    <a class="btn btn-primary" href="/">Back to home</a>
  </div>
</BaseLayout>

<style>
  .not-found { text-align: center; padding: clamp(4rem, 12vw, 8rem) 0; }
  .kicker { margin: 0 0 0.75rem; color: var(--sage); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { margin: 0 0 0.8rem; font-family: var(--font-display); font-size: clamp(1.9rem, 3.6vw, 2.75rem); line-height: 1.15; }
  p:not(.kicker) { margin: 0 0 1.5rem; color: var(--ink-soft); }
</style>

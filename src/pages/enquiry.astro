---
// Same tabbed CTA section as /consultation, just opened on the "Make an
// enquiry" tab instead — see CTATabs.astro for why this is one shared
// component rather than two separate implementations.
import BaseLayout from '../layouts/BaseLayout.astro';
import CTATabs from '../components/CTATabs.astro';
import BookingPanel from '../components/BookingPanel.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../config/site';
---

<BaseLayout title="Make an Enquiry" description="Send an enquiry about translation, financial protection, or pusaka management planning, or book a consultation directly.">
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href="/">Home</a> / Get in Touch</p>

    <section class="page-hero">
      <p class="eyebrow">Get in touch</p>
      <h1>Let's talk about what you need</h1>
      <p>Send a quick enquiry and hear back from {site.name} within {site.responseTimeBusinessDays} business days, or book a consultation slot directly — whichever suits you better.</p>
    </section>

    <CTATabs initialTab="enquire">
      <BookingPanel slot="book" hidden={true} />
      <EnquiryForm slot="enquire" hidden={false} />
    </CTATabs>
  </div>
</BaseLayout>

<style>
  .page-hero { padding: 1.75rem 0 2rem; text-align: center; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 0.8rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.15;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 0.8rem;
  }
  p { color: var(--ink-soft); }
  .page-hero p { max-width: 34rem; margin: 0 auto; }
</style>

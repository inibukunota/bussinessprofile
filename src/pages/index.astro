---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title={site.name} description="Professional translation, financial protection and pusaka management planning for individuals and families in Malaysia.">
<div class="home">
<section class="hero"><p class="eyebrow">Words · Protection · Legacy</p><h1>A steady hand for the things worth getting right.</h1><p>Clear, thoughtful professional services for individuals and families in Malaysia.</p></section>
<section class="services" aria-label="Services">
<a href="/services/translation-editing-writing" class="service"><span class="seal">01</span><h2>Translation, Editing &amp; Writing</h2><p>Documents, correspondence and content handled accurately between Bahasa Melayu and English.</p></a>
<a href="/services/financial-protection" class="service"><span class="seal">02</span><h2>Financial Protection Solutions</h2><p>Coverage built around your circumstances and the things you have worked to protect.</p></a>
<a href="/services/pusaka-management" class="service"><span class="seal">03</span><h2>Pusaka Management Planning</h2><p>Practical guidance for organising inheritance and estate matters for your family.</p></a>
</section></div>
</BaseLayout>
<style>
.home { width:min(1180px,calc(100% - 2 * clamp(1.25rem,4vw,3rem))); min-height:calc(100vh - 160px); margin-inline:auto; padding-block:clamp(1.5rem,4vw,2.5rem); display:flex; flex-direction:column; justify-content:center; }
.hero { max-width:44rem; margin:0 auto clamp(2rem,4vh,3rem); text-align:center; }
.eyebrow { margin:0 0 .9rem; color:var(--sage); font-family:var(--font-mono); font-size:.78rem; letter-spacing:.14em; text-transform:uppercase; }
h1 { margin:0 0 .9rem; color:var(--ink); font-family:var(--font-display); font-size:clamp(1.9rem,3.6vw,2.75rem); font-weight:600; line-height:1.15; }
.hero>p:last-child { margin:0; color:var(--ink-soft); font-size:clamp(1rem,1.3vw,1.1rem); line-height:1.6; }
.services { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(1rem,2vw,1.5rem); }
.service { display:flex; flex-direction:column; gap:1rem; padding:clamp(1.5rem,2.2vw,2rem) clamp(1.25rem,2vw,1.6rem); background:var(--parchment-2); border:1px solid var(--line); border-radius:var(--radius); color:var(--ink); text-decoration:none; transition:transform var(--transition),border-color var(--transition),box-shadow var(--transition); }
.service:hover,.service:focus-visible { transform:translateY(-3px); border-color:var(--brass); box-shadow:0 10px 24px -16px rgba(30,42,56,.35); }
.seal { width:52px; height:52px; display:grid; place-items:center; flex:0 0 auto; border:1.5px solid var(--brass); border-radius:50%; background:var(--white); color:var(--brass-dark); font-family:var(--font-mono); font-size:.7rem; }
h2 { margin:0; font-family:var(--font-display); font-size:1.25rem; font-weight:600; line-height:1.25; }
.service p { margin:0; color:var(--ink-soft); font-size:.92rem; line-height:1.55; }
@media (max-width:900px) { .home { min-height:auto; justify-content:flex-start; } .services { grid-template-columns:1fr; } }
</style>